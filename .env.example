# 变量清单：程序读取进程环境变量，不会自动加载 .env 文件。
# 用法：复制为 .env 后由 shell / docker compose 注入，或直接 export。
# 不配置模型也能完整运行（走本地规则引擎）。旧 AGENT_ 前缀仍兼容。

# ── 可选：大模型（OpenAI 兼容接口） ─────────────────────────────
MINGJIAN_LLM_BASE=
MINGJIAN_LLM_KEY=
MINGJIAN_LLM_MODEL=

# ── 采集窗口与规模 ─────────────────────────────────────────────
MINGJIAN_DAYS=30
MINGJIAN_MAX_COMPANIES=6
MINGJIAN_MAX_NEWS=45
MINGJIAN_MAX_ANN=40
MINGJIAN_MAX_FETCH=12

# ── 可选：数据库（留空则用 data/mingjian.db 本地 SQLite） ─────────
# 切服务端库需先装驱动：pip install -e ".[postgres]" 或 ".[mysql]"
# 建表脚本：sql/postgres.sql 或 sql/mysql.sql；连通性自检：tools/dbcheck.py
# MINGJIAN_DB_URL=postgresql://user:pass@127.0.0.1:5432/mingjian
# MINGJIAN_DB_URL=mysql://user:pass@127.0.0.1:3306/mingjian

# ── 通用模型环境变量兜底（与上面等价，按需二选一） ─────────────
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=